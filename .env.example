# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_application_id
DISCORD_PUBLIC_KEY=your_public_key

# Cerebras API Configuration
CEREBRAS_API_KEYS_FILE=./config/cerebras_api_keys.txt
CEREBRAS_DEFAULT_MODEL=gpt-oss-120b
CEREBRAS_MAX_RETRIES=5
CEREBRAS_RETRY_DELAY=2.0
# Free tier limits (gpt-oss-120b): 30 RPM, 64K TPM
# Pay-as-you-go: 1K RPM, 1M TPM
# Adjust based on your tier:
CEREBRAS_RATE_LIMIT_RPM=30
CEREBRAS_RATE_LIMIT_TPM=64000

# Supabase Configuration (optional but recommended for production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Redis Configuration (for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ChromaDB Configuration
CHROMADB_PATH=./data/chromadb
CHROMADB_COLLECTION=agent_memories

# Graph Database (NetworkX file-based)
GRAPH_DB_PATH=./data/graph_db.json

# OSINT Configuration (disabled by default for security)
OSINT_ENABLED=false
OSINT_MAX_DEPTH=3
OSINT_RATE_LIMIT_DELAY=1.5
TINEYE_API_KEY=
GOOGLE_API_KEY=
SHODAN_API_KEY=

# Agent Configuration
AGENT_NAME=Sentinel
AGENT_PERSONALITY_FILE=./config/personality.json
AGENT_MAX_WORKERS=10
AGENT_SLEEP_INTERVAL=300
AGENT_MEMORY_DECAY_RATE=0.01
AGENT_MEMORY_SCORE_THRESHOLD=0.3

# Security
ENCRYPTION_KEY=your_32_byte_encryption_key_here
ALLOWED_SERVERS=all
ADMIN_USER_IDS=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/logs/agent.log
SENTRY_DSN=

# Render.com Deployment
PORT=10000
HOST=0.0.0.0
WEB_CONCURRENCY=4